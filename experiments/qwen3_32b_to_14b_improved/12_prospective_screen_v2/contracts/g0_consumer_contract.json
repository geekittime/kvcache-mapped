{
  "contract_schema_version": 1,
  "consumer": "12_prospective_screen_v2",
  "receipt_artifact": {
    "required_ref_fields": ["path", "nbytes", "sha256"],
    "path_must_be_regular_non_symlink_file": true,
    "nbytes_and_sha256_must_match": true
  },
  "required_top_level_values": {
    "status": "complete",
    "pass": true,
    "closes_complete_g0": true,
    "scope": "decontaminated_registry_v2_vs_mapper_fit_and_locked_eval",
    "locked_outcomes_opened": false
  },
  "candidate_registry_binding": {
    "exact_keys": [
      "published_marker",
      "registry_manifest",
      "publication_receipt",
      "split_artifacts"
    ],
    "value_rule": "byte-exact JSON equality with the formal config native experiment-10 binding",
    "published_marker": {"type": "ArtifactRef"},
    "registry_manifest": {"type": "ArtifactRef"},
    "publication_receipt": {"type": "ArtifactRef"},
    "split_artifacts": {
      "exact_keys": [
        "hotpotqa_screen",
        "hotpotqa_confirm",
        "musique_screen",
        "musique_confirm"
      ],
      "value_type": "ArtifactRef"
    }
  },
  "comparisons": {
    "required_keys": [
      "methoddev_hotpot_vs_mapper_fit",
      "methoddev_musique_vs_mapper_fit",
      "methoddev_hotpot_vs_locked_eval",
      "methoddev_musique_vs_locked_eval"
    ],
    "direction_set_must_be_exact": true,
    "each_direction_exact_object": {"flags": 0},
    "additional_comparison_directions_allowed": false,
    "additional_fields_within_direction_allowed": false
  },
  "top_level_additional_evidence_fields_allowed": true,
  "fail_closed": true
}
